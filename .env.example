# Nothing here is secret: the site is fully static. Both values are optional.

# Path the site is served under. Set automatically by the deploy workflow
# (actions/configure-pages -> base_path, e.g. /portifolio). Leave empty locally.
PAGES_BASE_PATH=

# Public origin used for canonical URLs, hreflang, sitemap and Open Graph.
# The full site URL is always origin + base path.
NEXT_PUBLIC_SITE_ORIGIN=https://fabianoarthur.github.io
